diff --git a/src/parser/byte_parser.zig b/src/parser/byte_parser.zig
index 9c11321..9cad710 100644
--- a/src/parser/byte_parser.zig
+++ b/src/parser/byte_parser.zig
@@ -265,6 +265,43 @@ test "byte_parser payload too large returns FrameTooLarge" {
